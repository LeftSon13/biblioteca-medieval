<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- SESSÃO 1: o Spring Boot reúne versões compatíveis das bibliotecas do projeto. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.com.senac</groupId>
    <artifactId>biblioteca-medieval</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>biblioteca-medieval</name>
    <description>API de biblioteca para atividade do Senac</description>

    <properties>
        <!-- O código foi configurado para Java 21, usado no projeto anterior do curso. -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC cria os endpoints HTTP e entrega os arquivos da interface. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Spring Data JPA fornece os repositórios e a integração com Hibernate. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver que permite ao Java conversar com o PostgreSQL. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
